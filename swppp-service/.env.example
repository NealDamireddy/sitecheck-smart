# Supabase — ANON KEY ONLY.
# This service authenticates as the calling user; a service-role key here
# would bypass every RLS policy and is rejected at startup.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

ANTHROPIC_API_KEY=
# Must match AI_MODEL in ../src/lib/ai-model.ts (a test enforces this).
ANTHROPIC_MODEL=claude-opus-5

# ":memory:" runs Qdrant inside the process — no Docker needed.
# Per-process and lost on restart; point at a real instance for prod.
QDRANT_URL=:memory:
QDRANT_API_KEY=

# fastembed keeps customer SWPPP text on our own infrastructure.
# Switch to openai only as a deliberate decision — it sends legal-record
# documents to a second vendor.
EMBEDDING_PROVIDER=fastembed
# OPENAI_API_KEY=

# pymupdf: installs in seconds, no ML deps, good tables. Start here.
# Switch to marker for best fidelity once a real SWPPP defeats it.
PDF_BACKEND=pymupdf
