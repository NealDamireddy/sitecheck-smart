# SiteCheck environment.
#
#   cp .env.example .env.local     # local dev
#   cp .env.example .env           # docker compose
#
# NO REAL VALUES IN THIS FILE — it is committed. Generate secrets with
# the commands shown and keep them in your password manager or the
# platform's secret store (AWS Secrets Manager / Azure Key Vault).
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and
# is world-readable. Everything else is server-only; a leak of the
# service-role key or the credentials key is a full compromise.
# tests/security/bundle-secrets.test.ts fails the build if a server-only
# value ever reaches a client chunk.

# ─────────────────────────────────────────────────────────────────────
# Supabase — database, auth, storage  (REQUIRED)
# Project settings → API
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS. Used only by the migration runner, storage writes and
# the sync-job audit writer. Never import it into a user-facing route.
SUPABASE_SERVICE_ROLE_KEY=

# Supavisor session pooler URL (port 5432), for the migration runner.
# Project settings → Database → Connection string → Session pooler.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─────────────────────────────────────────────────────────────────────
# Anthropic — photo analysis, SWPPP extraction  (REQUIRED)
# Without it the app falls back to a deterministic mock, tagged
# model:'mock-deterministic'. Fine for a demo, never for a real filing.
# ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Weather — NOAA api.weather.gov  (REQUIRED)
# NOAA requires a User-Agent identifying the operator and rejects
# browser-like values. Include a contact address.
# ─────────────────────────────────────────────────────────────────────
NOAA_USER_AGENT=SiteCheck (ops@yourcompany.com)

# ─────────────────────────────────────────────────────────────────────
# Mapbox — site maps  (REQUIRED for map views)
# Public token; restrict it by URL in the Mapbox dashboard.
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# SMARTS automation  (REQUIRED to use Sync to SMARTS)
# ─────────────────────────────────────────────────────────────────────
# AES-256-GCM key encrypting each inspector's saved SMARTS password.
# Exactly 64 hex chars:  openssl rand -hex 32
# ROTATING THIS INVALIDATES EVERY SAVED PASSWORD — inspectors must
# re-enter theirs. There is no recovery path; that is the design.
SMARTS_CREDENTIALS_KEY=

# Shared fallback SMARTS account. OFF by default (SEC-08): without the
# opt-in below, a user with no saved credentials simply cannot sync,
# rather than silently filing under a shared identity. Single-tenant or
# dev deployments only.
SMARTS_ALLOW_ENV_FALLBACK=0
SMARTS_USERNAME=
SMARTS_PASSWORD=

# ─────────────────────────────────────────────────────────────────────
# Scheduled jobs and operations
# ─────────────────────────────────────────────────────────────────────
# Bearer token the scheduler presents to /api/cron/pre-storm-detector.
#   openssl rand -hex 32
CRON_SECRET=

# Token for /api/admin/apply-migrations. That endpoint is 404 in
# production builds unless ALLOW_REMOTE_MIGRATIONS=1 (SEC-02) — prefer
# running migrations from CI and leaving this unset in prod.
#   openssl rand -hex 32
ADMIN_MIGRATION_TOKEN=
# ALLOW_REMOTE_MIGRATIONS=1

# ─────────────────────────────────────────────────────────────────────
# Observability
# ─────────────────────────────────────────────────────────────────────
# debug | info | warn | error. Production logs are one JSON object per
# line; development is human-readable. Default: info in prod, debug otherwise.
LOG_LEVEL=info

# Stamped into the image and reported by /api/health so a running
# container is traceable to a commit. CI sets these.
# APP_COMMIT_SHA=
# APP_BUILD_TIME=

# ─────────────────────────────────────────────────────────────────────
# End-to-end tests  (see .env.test, scripts/seed-test-db.ts)
# Deliberately distinct from the variables above: the seed script
# REFUSES to run if these are unset or equal to the app's own Supabase
# URL, so E2E can never write to production.
# ─────────────────────────────────────────────────────────────────────
# E2E_BASE_URL=http://localhost:3000
# E2E_SUPABASE_URL=https://your-throwaway-project.supabase.co
# E2E_SUPABASE_SERVICE_ROLE_KEY=
# E2E_USER_A_EMAIL=
# E2E_USER_A_PASSWORD=
# E2E_USER_B_EMAIL=
# E2E_USER_B_PASSWORD=
# E2E_USER_A_PROJECT_ID=
